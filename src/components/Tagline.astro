---
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import { Code } from 'astro:components';
import { projects } from '../data/site';

const lines = [
  ['Terminal', 'first.'],
  ['Browser', 'next.'],
  ['Mobile', 'last.'],
];

const setup = [
  ['compositor', 'niri'],
  ['shell', 'zsh'],
  ['terminal', 'alacritty'],
  ['session', 'tmux'],
];

const editorConfig = `vim.g.mapleader = " "
vim.opt.number = true

require("config.lazy")`;

const tiles = String.raw` _____________
|             |
|             |
|             |
| >_          |
|_____________|`;
---

<section class="tagline-section container" aria-label="At home in the terminal">
  <div class="tagline-layout">
    <h2
      class="tagline heading-2"
      aria-label="Terminal first. Browser next. Mobile last."
    >
      {lines.map((line) => (
        <span class="tagline-line" aria-hidden="true">
          {line.map((word, index) => (
            <>
              {index > 0 && ' '}
              <span class="tagline-word">{word}</span>
            </>
          ))}
        </span>
      ))}
    </h2>
    <figure
      class="terminal-window body-6"
      aria-label="Desktop terminal illustration"
      data-reveal
    >
      <figcaption class="terminal-titlebar caption-2">
        <span aria-hidden="true">>_</span>
        <span>alacritty</span>
        <span class="terminal-path">~/projects</span>
      </figcaption>
      <div class="terminal-screen">
        <p class="terminal-command">
          <span class="terminal-prompt" aria-hidden="true">
            ~ $
          </span>
          <code>cat dotfiles.conf</code>
        </p>
        <div class="terminal-fetch">
          <pre class="terminal-tiles caption-5" aria-hidden="true">{tiles}</pre>
          <dl class="terminal-stack">
            {setup.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </div>
        <p class="terminal-command">
          <span class="terminal-prompt" aria-hidden="true">
            ~/projects $
          </span>
          <code>ls</code>
        </p>
        <ul class="terminal-projects" aria-label="Project directories">
          {projects.map((project) => (
            <li>
              <code>{project.id}/</code>
            </li>
          ))}
        </ul>
        <p class="terminal-command" aria-hidden="true">
          <span class="terminal-prompt">~/projects $</span>
        </p>
      </div>
      <section class="terminal-editor" aria-label="Neovim editor illustration">
        <div class="terminal-editor-tabline caption-4">
          <span>init.lua</span>
          <span class="terminal-editor-label">Neovim</span>
        </div>
        <Code
          code={editorConfig}
          lang="lua"
          theme="rose-pine"
          class="terminal-editor-code body-6"
        />
        <div class="terminal-editor-status caption-4">
          <span class="terminal-editor-mode">NORMAL</span>
          <span>LazyVim</span>
          <span class="terminal-editor-label">lua</span>
        </div>
      </section>
      <div class="terminal-status caption-4">
        <span class="terminal-session">[k8s]</span>
        <span class="terminal-active">0:stack*</span>
        <span class="terminal-status-label">tmux</span>
      </div>
    </figure>
  </div>
</section>
